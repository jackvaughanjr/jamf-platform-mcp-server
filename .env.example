# Jamf Platform API Gateway credentials.
# Create an integration in Jamf Account -> Integrations to obtain these.
# The client secret is displayed exactly once at creation — store it immediately.

JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# Set ONE of these. A Platform environment integration (the current kind) uses
# the environment id, sent as X-Environment-Id on every request — see Jamf
# Account > Platform Environments. A legacy Tenant-level integration uses the
# tenant id instead, sent as X-Tenant-Id, and cannot reach Blueprints.
JAMF_ENVIRONMENT_ID=
# JAMF_TENANT_ID=

# Regional gateway host. The beta documents the US gateway; override if your
# tenant is served from another region.
JAMF_GATEWAY_BASE_URL=https://us.api.jamfcloud.com

# Optional: override the token endpoint. Defaults to <base_url>/auth/token.
# JAMF_TOKEN_URL=

# Set to "true" to refuse any non-GET request at the client layer.
# Belt-and-braces only — the real guarantee is provisioning a read-only
# integration whose scopes exclude writes.
JAMF_READ_ONLY=true
