# 1Password secret references for `op run`. Copy to `.env.op` and edit to match
# your own vault and item — your real `.env.op` is gitignored so that local
# vault/item naming stays out of the repo.
#
#   cp .env.op.example .env.op
#   op run --env-file=.env.op -- ./scripts/discover-gateway.sh
#   op run --env-file=.env.op -- ./scripts/fetch-blueprints.sh
#
# Find your own reference paths:
#   op item list --format json | jq -r '.[] | "\(.title)  [\(.vault.name)]"'
#   op item get "<item title>" --format json | jq -r '.fields[].label'
#
# Verify resolution without printing the secret:
#   op run --env-file=.env.op -- sh -c 'echo "id=${JAMF_CLIENT_ID:0:6}…"'
#
# Quote the whole value if your vault or item name contains spaces.

JAMF_CLIENT_ID="op://<vault>/<item>/client id"
JAMF_CLIENT_SECRET="op://<vault>/<item>/client secret"
JAMF_TENANT_ID="op://<vault>/<item>/tenant id"

JAMF_GATEWAY_BASE_URL=https://us.apigw.jamf.com
JAMF_READ_ONLY=true

# If OP_SERVICE_ACCOUNT_TOKEN is exported globally in your shell, `op` will
# authenticate as that service account instead of prompting for biometrics, and
# will only see vaults granted to it. The committed .envrc unsets it for this
# repo so `op` falls back to Touch ID.
