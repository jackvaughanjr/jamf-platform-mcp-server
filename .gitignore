node_modules/
dist/
*.log

# Secrets — the client_secret is shown exactly once at creation. Never commit it.
.env
.env.*
!.env.example
# Only the templates are tracked. A real .env.op holds no secrets, but it does
# carry local 1Password vault and item names — keep that out of a shared repo.
!.env.op.example

# Gateway responses. Blueprint detail carries full device configuration —
# MDM declarations, restrictions, scope. Never commit it.
#
# Anchored with a leading slash on purpose: unanchored, `blueprints.json` also
# matches fixtures/shapes/blueprints.json, silently excluding the type-only
# schema that IS safe to commit. These patterns target the raw dump that
# scripts/fetch-blueprints.sh writes to the repo root.
/blueprints.json
/*.blueprints.json

# Raw gateway responses from discovery runs: device serials, usernames, email
# addresses, IPs, per-device application inventory. Only the type-only shapes
# under fixtures/shapes/ are committed.
fixtures/raw/

.DS_Store
*.tsbuildinfo
.claude/settings.local.json

# Agent worktrees. These are git worktrees of this repo, so `git add -A` from the
# root stages them as embedded repositories (gitlinks) rather than as files — which
# lands a commit SHA pointing at a directory no clone can resolve. Caught exactly
# that way once.
.claude/worktrees/
