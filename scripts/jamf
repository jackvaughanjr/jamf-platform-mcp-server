#!/usr/bin/env bash
#
# Cwd-independent wrapper for call-tool.mjs.
#
# `op run --env-file=.env.op` resolves that path against the CALLER's cwd, not the
# repo, so running it from anywhere else fails with a bare
# "open .env.op: no such file or directory" that does not hint at the cause.
# op owns that resolution, so the script itself cannot fix it — this passes an
# absolute path instead.
#
# Usage, from any directory:
#   scripts/jamf tools/list
#   scripts/jamf getFleetOverview
#   scripts/jamf findDevices '{"query":"MacBook"}'
#
set -euo pipefail

# Resolve symlinks before deriving the repo root. Invoked through a symlink on PATH
# (e.g. ~/.local/bin/jamf-mcp), BASH_SOURCE is the LINK's path, so a naive dirname
# yields the link's directory and every repo-relative lookup lands in the wrong
# place. Walks the chain rather than using `readlink -f`, which is not portable to
# older BSD/macOS.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  # A relative link target is relative to the link's own directory.
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$LINK_DIR/$SOURCE" ;;
  esac
done

REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
ENV_FILE="$REPO_ROOT/.env.op"

if [ ! -f "$ENV_FILE" ]; then
  printf '\033[31merror:\033[0m %s not found. Copy the template and edit it:\n' "$ENV_FILE" >&2
  printf '  cp %s/.env.op.example %s\n' "$REPO_ROOT" "$ENV_FILE" >&2
  exit 2
fi

if [ ! -f "$REPO_ROOT/dist/index.js" ]; then
  printf '\033[31merror:\033[0m server not built. Run: (cd %s && npm run build)\n' "$REPO_ROOT" >&2
  exit 2
fi

# The committed .envrc unsets this, but direnv only applies inside the repo — and
# the point of this wrapper is that it works from anywhere. Left set, `op`
# authenticates as the service account instead of prompting for biometrics and sees
# only the vaults granted to it, surfacing as a confusing
# "X isn't a vault in this account".
unset OP_SERVICE_ACCOUNT_TOKEN

exec op run --env-file="$ENV_FILE" -- node "$REPO_ROOT/scripts/call-tool.mjs" "$@"
